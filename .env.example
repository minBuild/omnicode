# OmniCode 설정 본보기 — /etc/omnicode/omnicode.env (설계 8.5, 16.6)
#
# - 설치 스크립트(infra/install/mcp-feature.sh)가 이 파일을 /etc/omnicode/omnicode.env 로 복사한다.
#   이미 있으면 덮어쓰지 않는다. 권한은 root:omnicode 0640.
# - systemd EnvironmentFile 형식: 한 줄에 KEY=value, 변수 확장 없음, # 로 시작하는 줄은 주석.
# - 비밀값은 여기에 두지 않는다. 업스트림 API 키·OAuth 토큰·client_secret·에이전트 토큰은 모두
#   Secrets Manager (omnicode/*) 에 있다.
# - omnicode.service 와 omnicode-backup.service 만 이 파일을 읽는다. omnicode-agentd.service 는 읽지
#   않는다 (에이전트 CLI 의 환경으로 새지 않게).

# ---------------------------------------------------------------------------
# API (packages/api)
# ---------------------------------------------------------------------------
# API 가 바인딩할 주소와 포트. 코드 기본값은 127.0.0.1 (TLS 를 끝내는 리버스 프록시 뒤에 두는 경우).
# CloudFront 가 EC2 에 직접 붙는 배포라면 0.0.0.0 으로 바꾸고 보안 그룹은 CloudFront 프리픽스 목록에만 연다.
# OMNICODE_API_PORT 는 omnicode-imds-guard 가 "omniagent → API 포트" 차단 규칙(17.2)에도 쓴다. 기본 8080.
OMNICODE_API_HOST=127.0.0.1
OMNICODE_API_PORT=8080

# 공개 URL (필수). CIMD client_id 와 OAuth redirect_uri (<URL>/oauth/callback) 의 기준. 끝에 / 없이.
# Tailscale 전용처럼 공개 도메인이 없는 배포는 비워 둔다 → CIMD 비활성 (10.3).
OMNICODE_PUBLIC_URL=https://omnicode.example.com

# 인증 방식. session = OmniCode 로그인 세션 쿠키를 직접 검증 (운영 기본, 16.1).
# dev = OMNICODE_DEV_TOKEN 베어러 토큰 (로컬 개발 전용. 공개 배포에서는 설치 스크립트가 막는다).
OMNICODE_AUTH_MODE=session

# 개발 전용 베어러 토큰. OMNICODE_AUTH_MODE=dev 일 때만 읽는다. 운영 env 파일에는 두지 않는다.
#OMNICODE_DEV_TOKEN=

# 화면(packages/web 빌드 결과)을 정적으로 제공할 디렉터리.
OMNICODE_WEB_DIR=/opt/omnicode/packages/web/dist

# ---------------------------------------------------------------------------
# Hub (설계 8.5)
# ---------------------------------------------------------------------------
# Hub 리스너 포트. 항상 127.0.0.1 에만 바인딩한다. 에이전트용 MCP 엔드포인트 + /healthz.
OMNICODE_HUB_PORT=7410

# SQLite 레지스트리(registry.sqlite)와 백업 디렉터리 위치. omnicode:omnicode 0700.
OMNICODE_DATA_DIR=/var/lib/omnicode

# agentd 유닉스 소켓.
OMNICODE_AGENTD_SOCKET=/run/omnicode/agentd.sock

# Secrets Manager 이름 접두사. 서버별 시크릿은 <접두사>/mcp/<id>, 에이전트 토큰은 <접두사>/hub-tokens.
OMNICODE_SECRETS_PREFIX=omnicode

# 시크릿 저장소. aws = Secrets Manager (운영). file, memory 는 개발·테스트 전용.
OMNICODE_SECRETS_BACKEND=aws

# 도구 호출 wall-clock 기본값 (ms). 서버별 설정이 덮어쓴다 (11.7).
OMNICODE_MCP_CALL_TIMEOUT_MS=600000

# progress 알림 없이 기다리는 최대 시간 (ms) (11.7).
OMNICODE_MCP_IDLE_TIMEOUT_MS=300000

# SSRF 차단 예외 (16.2). 호스트 이름 또는 CIDR 목록 (쉼표 구분). 설정하면 화면에 배지가 뜨고,
# 해당 서버 추가에는 재인증이 필요하다. 보통 비워 둔다.
OMNICODE_MCP_ALLOW_PRIVATE_HOSTS=

# 개발용. 1 이면 http://127.0.0.1 업스트림을 허용한다. 운영은 0.
OMNICODE_MCP_ALLOW_HTTP_LOOPBACK=0

# 감사 로그·이벤트 보존 일수 (17.4), 상태 점검 주기 (ms, 17.3).
OMNICODE_AUDIT_RETENTION_DAYS=30
OMNICODE_EVENT_RETENTION_DAYS=180
OMNICODE_HEALTH_INTERVAL_MS=600000

# Hub 토큰 재발급 후 이전 토큰을 계속 받아 주는 시간 (ms) (10.5).
OMNICODE_AGENT_TOKEN_GRACE_MS=900000

# ---------------------------------------------------------------------------
# agentd 소켓 · 백업
# ---------------------------------------------------------------------------
# agentd 소켓에 접속할 수 있어야 하는 그룹 (8.2: agentd.sock 은 omniagent:<그룹> 0660).
OMNICODE_AGENTD_GROUP=omnicode

# 레지스트리 백업 S3 버킷 (17.4). "버킷" 또는 "버킷/접두사". 비어 있으면 omnicode-backup 이 실패한다.
# infra/aws/iam-policy.json 의 __OMNICODE_BACKUP_BUCKET__ 자리에도 같은 버킷 이름을 넣는다.
OMNICODE_BACKUP_BUCKET=
