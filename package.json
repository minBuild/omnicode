{
  "name": "omnicode",
  "version": "0.1.0",
  "private": true,
  "description": "OmniCode — personal agent workspace on your own AWS account. MCP management (design 0001).",
  "type": "module",
  "engines": { "node": ">=22.13 <27" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "validate:presets": "node scripts/validate-presets.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
