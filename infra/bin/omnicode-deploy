#!/bin/sh
# omnicode-deploy — EC2 에서 소스를 빌드하고 서비스를 재시작한다 (root 로 실행).
#   OMNICODE_REPO   체크아웃 위치 (기본 /opt/omnicode)
#   --no-restart    빌드만 하고 systemd 재시작은 건너뛴다
#   --pull          빌드 전에 git pull --ff-only
set -eu

REPO="${OMNICODE_REPO:-/opt/omnicode}"
RESTART=1
PULL=0
for arg in "$@"; do
  case "$arg" in
    --no-restart) RESTART=0 ;;
    --pull) PULL=1 ;;
    -h|--help) sed -n '2,6p' "$0"; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

[ -d "$REPO" ] || { echo "repo not found: $REPO" >&2; exit 1; }
cd "$REPO"
command -v node >/dev/null 2>&1 || { echo "node is required" >&2; exit 1; }
command -v npm >/dev/null 2>&1 || { echo "npm is required" >&2; exit 1; }

if [ "$PULL" -eq 1 ]; then
  git pull --ff-only
fi

echo "== npm ci"
npm ci --no-audit --no-fund
echo "== build (tsc + migrations)"
npm run build
echo "== build web"
npm run build --workspace @omnicode/web
echo "== validate presets"
npm run validate:presets

# 서비스 사용자가 읽을 수 있어야 한다 (omnicode.service 는 ProtectSystem=strict 로 /opt 를 읽기 전용으로 본다)
chown -R root:root "$REPO"
chmod -R a+rX "$REPO"

if [ "$RESTART" -eq 1 ] && command -v systemctl >/dev/null 2>&1; then
  echo "== restart services"
  systemctl restart omnicode-agentd.service
  systemctl restart omnicode.service
  systemctl --no-pager --lines=0 status omnicode-agentd.service omnicode.service || true
fi
echo "deploy done"
