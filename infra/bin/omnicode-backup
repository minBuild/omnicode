#!/bin/sh
# omnicode-backup: daily snapshot of the OmniCode databases (design 0001 17.4, 0002 4).
# Installed to /usr/local/sbin; run as the `omnicode` user by omnicode-backup.timer.
#
# For each database — registry.sqlite (required) and auth.sqlite (if present; session auth mode):
#   1. sqlite3 "VACUUM INTO" -> $OMNICODE_DATA_DIR/backup/<name>-<YYYY-MM-DD>.sqlite
#      (a consistent snapshot; the live DB file is never copied)
#   2. aws s3 cp --sse AES256 -> s3://$OMNICODE_BACKUP_BUCKET/<name>-<YYYY-MM-DD>.sqlite
#   3. keep the newest 14 snapshots of each locally and the newest 14 of each in S3
#
# auth.sqlite holds passkey public keys and session token hashes only (no secrets), so restoring it
# lets the owner log in with the same passkeys as long as OMNICODE_PUBLIC_URL's host is unchanged.
#
# Environment (from /etc/omnicode/omnicode.env via the unit):
#   OMNICODE_BACKUP_BUCKET   required. Bucket name, optionally with a key prefix: "my-bucket/omnicode"
#   OMNICODE_DATA_DIR        default /var/lib/omnicode
# Exit status is non-zero (and the reason is on stderr) if the bucket is unset or any step fails;
# a local snapshot that was already written is kept in that case.
set -eu

DATA_DIR="${OMNICODE_DATA_DIR:-/var/lib/omnicode}"
BACKUP_DIR="$DATA_DIR/backup"
KEEP="${OMNICODE_BACKUP_KEEP:-14}"
BUCKET="${OMNICODE_BACKUP_BUCKET:-}"
SQLITE="${SQLITE3:-sqlite3}"
AWS="${AWS_CLI:-aws}"

die() {
  printf 'omnicode-backup: %s\n' "$*" >&2
  exit 1
}

# --- preconditions ---------------------------------------------------------
[ -n "$BUCKET" ] || die "OMNICODE_BACKUP_BUCKET is not set in /etc/omnicode/omnicode.env; refusing to run without an off-host copy"
case "$BUCKET" in
  *[!A-Za-z0-9._/-]*|/*|*/) die "OMNICODE_BACKUP_BUCKET must look like 'bucket' or 'bucket/prefix' (got '$BUCKET')" ;;
esac
case "$KEEP" in
  ''|*[!0-9]*) die "OMNICODE_BACKUP_KEEP must be a number" ;;
esac
command -v "$SQLITE" >/dev/null 2>&1 || die "$SQLITE not found (install sqlite3)"
command -v "$AWS" >/dev/null 2>&1 || die "$AWS CLI not found"
case "$DATA_DIR" in
  *\'*) die "OMNICODE_DATA_DIR must not contain a single quote" ;;
esac

mkdir -p "$BACKUP_DIR"
chmod 0700 "$BACKUP_DIR"

# --- per-database snapshot, upload, retention --------------------------------
stamp="$(date -u +%Y-%m-%d)"

# $1 = file name prefix (snapshots are <prefix>-<YYYY-MM-DD>.sqlite)
prune() {
  prefix="$1"
  # File names embed a zero-padded UTC date, so sorted glob order is chronological (oldest first).
  n=0
  for f in "$BACKUP_DIR"/"$prefix"-*.sqlite; do
    [ -f "$f" ] && n=$((n + 1))
  done
  while [ "$n" -gt "$KEEP" ]; do
    for f in "$BACKUP_DIR"/"$prefix"-*.sqlite; do
      [ -f "$f" ] || continue
      rm -f -- "$f"
      printf 'pruned local: %s\n' "${f##*/}"
      break
    done
    n=$((n - 1))
  done

  remote_keys="$("$AWS" s3 ls -- "s3://$BUCKET/$prefix-" | awk -v p="$prefix" '$4 ~ ("^" p "-[0-9-]+\\.sqlite$") { print $4 }' | sort)"
  remote_count="$(printf '%s\n' "$remote_keys" | grep -c "^$prefix-" || true)"
  if [ "$remote_count" -gt "$KEEP" ]; then
    printf '%s\n' "$remote_keys" | head -n "$((remote_count - KEEP))" | while IFS= read -r key; do
      [ -n "$key" ] || continue
      "$AWS" s3 rm --only-show-errors -- "s3://$BUCKET/$key"
      printf 'pruned remote: %s\n' "$key"
    done
    remote_count="$KEEP"
  fi
  printf 'done: %s local=%s remote=%s (keep %s)\n' "$prefix" "$n" "$remote_count" "$KEEP"
}

# $1 = database base name (registry|auth), $2 = 1 if the database must exist
backup_db() {
  base="$1"
  db="$DATA_DIR/$base.sqlite"
  if [ ! -f "$db" ]; then
    [ "$2" = 1 ] && die "database not found: $db"
    printf 'skip: %s (not present)\n' "$db"
    return 0
  fi
  name="$base-$stamp.sqlite"
  final="$BACKUP_DIR/$name"
  tmp="$final.tmp"

  rm -f -- "$tmp"
  "$SQLITE" "$db" "VACUUM INTO '$tmp'"
  "$SQLITE" "$tmp" "PRAGMA integrity_check;" | grep -qx ok || die "integrity check failed on $tmp"
  chmod 0600 "$tmp"
  mv -f -- "$tmp" "$final"
  printf 'snapshot: %s (%s bytes)\n' "$final" "$(wc -c < "$final" | tr -d ' ')"

  dest="s3://$BUCKET/$name"
  "$AWS" s3 cp --only-show-errors --sse AES256 -- "$final" "$dest"
  printf 'uploaded: %s\n' "$dest"

  prune "$base"
}

backup_db registry 1
backup_db auth 0
