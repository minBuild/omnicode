# OmniCode agent daemon (design 12.2, 17.1). Installed by infra/install/mcp-feature.sh.
# Runs as the untrusted-side `omniagent` user: edits agent CLI config files, writes token files,
# runs `claude mcp ...`. It talks to the Hub only through /run/omnicode/agentd.sock.
#
# Socket activation (D7, P10): omnicode-agentd.socket owns /run/omnicode/agentd.sock (omniagent:omnicode
# 0660) and hands it over as fd 3 (LISTEN_FDS/LISTEN_PID). The daemon only listens on that fd; it does not
# create, chmod, chgrp or remove the file, so it needs no write access to /run/omnicode. Starting this
# service directly starts the socket too (Requires=) and still receives it as fd 3. While the daemon
# restarts, the API's connections wait in the socket's listen queue. The iptables guard must be in place
# before any agent CLI runs (17.2, P9), also when the first connection is what starts the daemon.
[Unit]
Description=OmniCode agent daemon (agentd)
Documentation=file:///opt/omnicode/docs/design/0001-mcp-management.md
Requires=omnicode-agentd.socket omnicode-imds-guard.service
After=network.target omnicode-imds-guard.service omnicode-agentd.socket

[Service]
Type=simple
User=omniagent
Group=omniagent
SupplementaryGroups=
Environment=OMNICODE_AGENTD_SOCKET=/run/omnicode/agentd.sock
Environment=HOME=/home/omniagent
WorkingDirectory=/home/omniagent
ExecStart=/usr/bin/node /opt/omnicode/packages/agentd/dist/main.js
Restart=always
RestartSec=2
# Nothing this daemon (or a CLI it spawns) creates is ever world-accessible.
UMask=0007

# Hardening. Only the agent home is writable (the socket belongs to omnicode-agentd.socket). Do not add
# EnvironmentFile=/etc/omnicode/omnicode.env here: systemd reads it as root and the values would
# leak into every agent CLI this daemon spawns.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/omniagent
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
