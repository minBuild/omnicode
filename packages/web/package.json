{
  "name": "@omnicode/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OmniCode MCP 관리 화면 (모바일 우선 SPA). API 패키지가 dist/를 정적으로 제공한다.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@omnicode/shared": "0.1.0",
    "@simplewebauthn/browser": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.3"
  }
}
